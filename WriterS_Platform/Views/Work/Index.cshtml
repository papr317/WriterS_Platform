@model WriterS_Platform.ViewModels.PagedResult<WriterS_Platform.ViewModels.WorkViewModel>

@{
    ViewData["Title"] = "Все Произведения";
}

<h1>Все Произведения</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Опубликовать новое произведение</a>
</p>

<form asp-action="Index" method="get" class="mb-4">
    <div class="form-row">
        <div class="col-md-4 mb-2">
            <input type="text" name="SearchTerm" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Поиск по названию или автору" />
        </div>
        <div class="col-md-3 mb-2">
            <input type="text" name="Genre" value="@ViewData["CurrentGenre"]" class="form-control" placeholder="Поиск по жанру" />
        </div>
        <div class="col-md-3 mb-2">
            <select name="SortBy" class="form-control">
                <option value="newest" selected="@(ViewData["CurrentSort"] == null || ViewData["CurrentSort"]?.ToString() == "newest")">Сначала новые</option>
                <option value="oldest" selected="@(ViewData["CurrentSort"]?.ToString() == "oldest")">Сначала старые</option>
                <option value="ratingdesc" selected="@(ViewData["CurrentSort"]?.ToString() == "ratingdesc")">По рейтингу (убывание)</option>
                <option value="ratingasc" selected="@(ViewData["CurrentSort"]?.ToString() == "ratingasc")">По рейтингу (возрастание)</option>
                <option value="titleasc" selected="@(ViewData["CurrentSort"]?.ToString() == "titleasc")">По названию (А-Я)</option>
                <option value="titledesc" selected="@(ViewData["CurrentSort"]?.ToString() == "titledesc")">По названию (Я-А)</option>
                <option value="commentsdesc" selected="@(ViewData["CurrentSort"]?.ToString() == "commentsdesc")">По количеству комментариев</option>
            </select>
        </div>
        <div class="col-md-2 mb-2">
            <button type="submit" class="btn btn-info">Применить</button>
            <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        </div>
    </div>
</form>

@if (Model != null && Model.Items != null && Model.Items.Any())
{
    <div class="row">
        @foreach (var work in Model.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@work.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@work.Genre</h6>
                        <p class="card-text">Автор: @work.AuthorNikeName</p>
                        <p class="card-text"><small class="text-muted">Опубликовано: @work.PublicationDate.ToShortDateString()</small></p>
                        <p class="card-text">Рейтинг: @work.AvgRating/100</p>
                        <p class="card-text">Комментарии: @work.CommentsCount</p>
                        <a asp-action="Details" asp-route-id="@work.WorkID" class="btn btn-primary">Читать</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Произведения не найдены.</p>
}

@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Page navigation example">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchTerm="@ViewData["CurrentFilter"]" asp-route-genre="@ViewData["CurrentGenre"]" asp-route-sortBy="@ViewData["CurrentSort"]">Предыдущая</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@ViewData["CurrentFilter"]" asp-route-genre="@ViewData["CurrentGenre"]" asp-route-sortBy="@ViewData["CurrentSort"]">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchTerm="@ViewData["CurrentFilter"]" asp-route-genre="@ViewData["CurrentGenre"]" asp-route-sortBy="@ViewData["CurrentSort"]">Следующая</a>
            </li>
        </ul>
    </nav>
}